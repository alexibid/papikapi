# Copy to .env (git ignores it). Read by tools/builder/write-app-env.mjs before build and serve.
# Google Cloud API key restricted to the Drive API, used to read the public figures folder.
FIGURE_DRIVE_API_KEY=
# Optional: id of ibid-assets/papikapi/figures/index.json when it differs from the built-in one.
FIGURE_DRIVE_INDEX_FILE_ID=
