{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "camila-tauri",
  "version": "0.1.2",
  "identifier": "com.camila.app",
  "build": {
    "frontendDist": "../../../../../dist/camila/browser",
    "devUrl": "http://localhost:4400",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Camila",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
